# Accounts mode (Supabase). Leave empty to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth > Hooks > Send SMS hook secret (starts with v1,whsec_)
SEND_SMS_HOOK_SECRET=

# Africa's Talking. Use AT_USERNAME=sandbox while testing.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Any long random string; Vercel sends it to the daily reminder job.
CRON_SECRET=

# Claude API key, for reading CRB reports and bank statement PDFs and naming
# industries the built-in list doesn't know. Without it those uploads say
# "not switched on yet"; M-PESA statements and CSVs still work.
ANTHROPIC_API_KEY=

# ---- WhatsApp (Afueni), see docs/SETUP-whatsapp.md ----
# From Meta: App settings > Basic > App secret. Used to check every webhook is really from Meta.
WHATSAPP_APP_SECRET=
# Any long random string you make up; paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Permanent System User access token with whatsapp_business_messaging and whatsapp_business_management.
WHATSAPP_TOKEN=
# WhatsApp > API Setup > Phone number ID (a long number, not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Optional. Graph API version (default v25.0) and the follow-up template's name (default afueni_follow_up).
WHATSAPP_GRAPH_VERSION=
WHATSAPP_FOLLOWUP_TEMPLATE=
# The public WhatsApp number, digits with country code (e.g. 254712345678), for the "Chat on WhatsApp" link.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Coach inbox at /coach: a shared key of at least 24 characters, and the phone that gets an SMS when a case opens.
COACH_ACCESS_KEY=
COACH_ALERT_PHONE=
# Public address of the app, used in links sent on WhatsApp.
APP_URL=https://risk-radar-borrower.vercel.app
